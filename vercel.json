{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:seo && npm run audit:geo",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "irigoyendev.com" }],
      "destination": "https://www.irigoyendev.com/:path*",
      "permanent": true
    },
    { "source": "/cotizacion", "destination": "/pages/cotizacion", "permanent": true },
    { "source": "/calafate", "destination": "/projects/calafate", "permanent": true },
    { "source": "/dahuss", "destination": "/projects/dahuss", "permanent": true },
    { "source": "/dragonmart", "destination": "/projects/dragonmart", "permanent": true },
    { "source": "/familiainternacional", "destination": "/projects/familiainternacional", "permanent": true },
    { "source": "/floreria", "destination": "/projects/floreria", "permanent": true },
    { "source": "/radiochicureo", "destination": "/projects/radiochicureo", "permanent": true },
    { "source": "/retorica", "destination": "/projects/retorica", "permanent": true },
    { "source": "/rluabogados", "destination": "/projects/rluabogados", "permanent": true },
    { "source": "/thebeebaby", "destination": "/projects/thebeebaby", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "off" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-site" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://wa.me; script-src 'self' https://cdn.jsdelivr.net https://esm.sh 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://esm.sh; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|ai\\.txt|humans\\.txt|site\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/santiago/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/norge/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
